
struct ContentView: View {
    @StateObject var data = University()
    @State var selected: Student?
    @State var editing: StudentRecord?
    @State var input = ""
    @State var showEdit = false

    var body: some View {
        NavigationStack {
            List {
                Section("Student Ranking") {
                    ForEach(data.students.sorted {
                        (average($0, data.records) ?? -1) >
                        (average($1, data.records) ?? -1)
                    }) { student in
                        Button {
                            selected = student
                        } label: {
                            VStack(alignment: .leading) {
                                Text(student.displayInfo())
                                    .foregroundStyle(.primary)

                                let avg = average(student, data.records)

                                Text("Average: \(avg.map { String(format: "%.2f", $0) } ?? "N/A") • \(ranking(avg))")
                                    .font(.subheadline)
                                    .foregroundStyle(.secondary)
                            }
                        }
                    }
                }

                if let student = selected {
                    Section("\(student.name)'s Results") {
                        ForEach(data.records.filter {
                            $0.student.id == student.id
                        }) { record in
                            HStack {
                                VStack(alignment: .leading) {
                                    Text(record.subject.name)

                                    Text(record.isPassed() ? "Passed" : "Failed")
                                        .font(.caption)
                                        .foregroundStyle(
                                            record.isPassed() ? .green : .red
                                        )
                                }

                                Spacer()

                                VStack(alignment: .trailing) {
                                    Text(String(format: "%.1f", record.mark))

                                    Button("Edit") {
                                        editing = record
                                        input = String(record.mark)
                                        showEdit = true
                                    }
                                    .font(.caption)
                                }
                            }
                        }
                    }
                }

                Section("Subjects") {
                    ForEach(data.subjects) { subject in
                        Text("\(subject.name) - \(subject.credits) credits")
                    }
                }

                if !data.message.isEmpty {
                    Section("Status") {
                        Text(data.message)
                    }
                }
            }
            .navigationTitle("Student Manager")
            .sheet(isPresented: $showEdit) {
                NavigationStack {
                    Form {
                        TextField("Mark (0–10)", text: $input)
                            .keyboardType(.decimalPad)
                    }
                    .navigationTitle("Edit Mark")
                    .toolbar {
                        ToolbarItem(placement: .confirmationAction) {
                            Button("Save") {
                                let value = input.replacingOccurrences(
                                    of: ",",
                                    with: "."
                                )

                                if let mark = Double(value),
                                   let record = editing {
                                    data.update(record, mark)
                                    showEdit = false
                                } else {
                                    data.message = "Invalid mark."
                                }
                            }
                        }

                        ToolbarItem(placement: .cancellationAction) {
                            Button("Cancel") {
                                showEdit = false
                            }
                        }
                    }
                }
            }
        }
    }
}

#Preview {
    ContentView()
}
